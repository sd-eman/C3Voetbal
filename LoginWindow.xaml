<Window
    x:Class="C3Voetbal.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="C3Voetbal - Login">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid Background="#4a5c3a">
        <StackPanel Width="320" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Spacing="12">

            <TextBlock Text="⚽ C3Voetbal" FontSize="32" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBox x:Name="EmailBox"
                     PlaceholderText="E-mailadres"/>

            <PasswordBox x:Name="PasswordBox"
                         PlaceholderText="Wachtwoord"/>

            <Button x:Name="LoginButton"
                    Content="Inloggen"
                    HorizontalAlignment="Stretch"
                    Margin="0,8,0,0"
                    Background="#8ba060"
                    Foreground="White"
                    Click="LoginButton_Click"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="#ff6b6b"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>